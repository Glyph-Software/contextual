# Optional local setup: copy to .env after installing the dependencies below.
# Ollama must be running with: ollama pull qwen3-embedding:0.6b
CONTEXTUAL_EMBED_PROVIDER=ollama
CONTEXTUAL_EMBED_MODEL=qwen3-embedding:0.6b

# Requires Tesseract and Poppler; both are included in the Docker image.
CONTEXTUAL_OCR=local
CONTEXTUAL_OCR_LANGUAGE=eng
