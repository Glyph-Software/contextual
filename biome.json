{
	"formatter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"correctness": {
				"noConstAssign": "error",
				"noUnreachable": "error",
				"noUnusedLabels": "error",
				"noUnsafeFinally": "error",
				"noSelfAssign": "error"
			},
			"suspicious": {
				"noDuplicateCase": "error",
				"noCompareNegZero": "error",
				"noDebugger": "error"
			}
		}
	}
}
